# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# ---- Database ----
# MongoDB Atlas connection string.
# Atlas > your cluster > Connect > Drivers. Remember to URL-encode any special
# characters in the password, and add your IP (or 0.0.0.0/0 for dev) to Network Access.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/topgoals?retryWrites=true&w=majority"

# ---- Auth.js ----
# Signing secret for session cookies. Generate one with: npx auth secret
AUTH_SECRET=""

# ---- Bootstrap admin (used only by `npm run seed`) ----
# The first admin account, created so you can log into the CMS.
# Change the password after your first login.
ADMIN_NAME="Site Owner"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# ---- Cloudinary (image & video uploads) ----
# Cloudinary dashboard > Settings > API Keys.
#
# The cloud name and API key are NOT secrets — the browser upload widget needs
# both, hence the NEXT_PUBLIC_ prefix. The API SECRET is server-only: it signs
# upload requests and must never be given a NEXT_PUBLIC_ prefix.
# All three are required for uploads to work.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
